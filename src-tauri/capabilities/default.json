{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "main window: the picked vault directory, dialogs, page fetches for the intake, ilmi:// links, a clipped page's address opened in the browser, dev logging",
  "windows": ["main", "second"],
  "permissions": [
    "core:default",
    "core:window:allow-set-focus",
    "core:window:allow-set-title",
    "core:window:allow-unminimize",
    "dialog:default",
    "deep-link:default",
    "opener:default",
    "log:default",
    "fs:default",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-rename",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-stat",
    "fs:allow-exists",
    "fs:allow-watch",
    "fs:allow-unwatch",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://**" }, { "url": "http://**" }, { "url": "https://**:*" }, { "url": "http://**:*" }]
    }
  ]
}
