{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ilmi",
  "version": "0.3.0",
  "identifier": "dev.ilmi.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ilmi",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["pdf"], "contentTypes": ["com.adobe.pdf"], "name": "PDF", "role": "Viewer", "rank": "Alternate" },
      { "ext": ["epub"], "contentTypes": ["org.idpf.epub-container"], "name": "EPUB", "role": "Viewer", "rank": "Alternate" },
      {
        "ext": ["apkg"],
        "contentTypes": ["dev.ilmi.apkg"],
        "name": "Anki package",
        "role": "Viewer",
        "rank": "Alternate",
        "exportedType": { "identifier": "dev.ilmi.apkg", "conformsTo": ["public.data"] }
      },
      {
        "ext": ["md", "markdown", "txt", "text", "html", "htm", "csv", "tsv"],
        "contentTypes": ["net.daringfireball.markdown", "public.plain-text", "public.html", "public.comma-separated-values-text", "public.tab-separated-values-text"],
        "name": "Text",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "deep-link": {
      "desktop": {
        "schemes": ["ilmi"]
      },
      "mobile": [{ "scheme": ["ilmi"], "appLink": false }]
    }
  }
}
